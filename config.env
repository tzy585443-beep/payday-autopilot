# Payday Autopilot — network configuration (testnet). Secrets live in .secrets (never committed).

# Reactive Network (Lasna testnet)
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_CHAIN_ID=5318007
REACTIVE_EXPLORER=https://lasna.reactscan.net

# Origin = where income arrives; Destination = where the executor moves funds.
# Default: Ethereum Sepolia for both (Lasna sits in the middle).
ORIGIN_RPC=https://ethereum-sepolia-rpc.publicnode.com
ORIGIN_CHAIN_ID=11155111
DEST_RPC=https://ethereum-sepolia-rpc.publicnode.com
DEST_CHAIN_ID=11155111
DEST_EXPLORER=https://sepolia.etherscan.io
CALLBACK_PROXY=0xAa14d9Cd0f788Ca23d11805986C1d8bd035D23b4   # Ethereum Sepolia callback proxy

# Alternative: Base Sepolia
# ORIGIN_RPC=https://sepolia.base.org; ORIGIN_CHAIN_ID=84532; DEST_RPC=https://sepolia.base.org; DEST_CHAIN_ID=84532
# DEST_EXPLORER=https://sepolia.basescan.org; CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# Alternative (only needs lREACT): everything on Lasna
# ORIGIN_RPC=$REACTIVE_RPC; ORIGIN_CHAIN_ID=5318007; DEST_RPC=$REACTIVE_RPC; DEST_CHAIN_ID=5318007
# CALLBACK_PROXY=0x8888888888888888888888888888888888888888; DEST_EXPLORER=$REACTIVE_EXPLORER

# Rules
MIN_INCOME=100000000          # 100 tUSD (6 decimals)
SAVE_BPS=2000                 # save 20% of every paycheck
MAX_SAVE_PER_DAY=1000000000   # never move more than 1,000 tUSD per 24h
CRON_TOPIC=0xb49937fb8970e19fd46d48f7e3fb00d659deac0347f79cd7cb542f0fc1503c70  # Cron100 (~every 100 Lasna blocks)
RECURRING_INTERVAL=180        # demo: pay rent every 3 minutes (real life: 2592000 = 30 days)
RECURRING_AMOUNT=50000000     # 50 tUSD
RECURRING_MIN_GAP=120         # executor-side rate limit (seconds)

# Callback gas: Sepolia storage writes are expensive; onIncome measured ~710k gas there
CALLBACK_GAS_LIMIT=1500000

# Funding (testnet)
REACTIVE_FUND=0.5ether        # lREACT sent to PaydayReactive for reactive tx fees
EXECUTOR_FUND=0.002ether      # destination-chain ETH sent to PaydayExecutor for callback fees

[0.004, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.004, "o", "$ ./scripts/local-sim.sh   # LOCAL SIMULATION: anvil + mock system contract\r\n"]
[1.566, "o", "\r\n\u001b[1;36m==> Setup (local anvil, chain 31337): etch mock system contract at 0x8888888888888888888888888888888888888888\u001b[0m\r\n"]
[3.542, "o", "TestUSD        0x5FbDB2315678afecb367f032d93F642f64180aa3\r\n"]
[3.562, "o", "PaydayReactive 0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512  (subscriptions: 2)\r\nPaydayExecutor 0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0\r\n"]
[3.562, "o", "Rules: save 20% of paychecks >= 100 tUSD from 0x772A513043317B178291b7039cE0a81F70cb386D, max 1,000/day; rent 900 tUSD every 30 days\r\n"]
[3.624, "o", "\r\n\u001b[1;36m==> Before: wallet=0.00 savings=0.00 landlord=0.00\u001b[0m\r\n"]
[4.925, "o", "\r\n\u001b[1;36m==> 1) Payday: employer sends 3,000 tUSD to the wallet\u001b[0m\r\n"]
[6.255, "o", "   origin tx 0xeeb6b88360241d29126f88efb67899249d0de828444f4f56a73cf3852a39faed\r\n"]
[6.337, "o", "   [network] react() delivered on Reactive side\r\n"]
[6.385, "o", "   [network] callback posted to PaydayExecutor: 0x78bba61e34baa439cffc53d5175855b71f8c30f23ad072b4c7b506720dabec0f\r\n"]
[6.425, "o", "\r\n\u001b[1;36m==>    wallet=2400.00  savings=600.00   <- 20% saved automatically\u001b[0m\r\n"]
[7.726, "o", "\r\n\u001b[1;36m==> 2) A stranger airdrops 500 tUSD (untrusted payer) -> ignored\u001b[0m\r\n"]
[9.115, "o", "   origin tx 0xe3567b8560565c6d9f43c0cf9a053e14e830c4263345a979f44b55a6e023a572\r\n"]
[9.192, "o", "   [network] react() delivered on Reactive side\r\n"]
[9.211, "o", "   [network] react() filtered it out -> no callback requested (nothing moved)\r\n"]
[9.247, "o", "\r\n\u001b[1;36m==>    savings=600.00  (unchanged)  ignoredEvents=1\u001b[0m\r\n"]
[10.549, "o", "\r\n\u001b[1;36m==> 3) Second paycheck of 6,000 tUSD the same day -> daily cap (1,000) limits the sweep\u001b[0m\r\n"]
[11.877, "o", "   origin tx 0xe2fe23fdbbf0095cf17e5c1515570277cf24f341f4b99de477d9baae48445d65\r\n"]
[11.957, "o", "   [network] react() delivered on Reactive side\r\n"]
[12.0, "o", "   [network] callback posted to PaydayExecutor: 0xf2c74c145636e0d7e294ce76d56d3fe8401950dbc13464bf8dbc49f49b74d53b\r\n"]
[12.018, "o", "\r\n\u001b[1;36m==>    savings=1000.00  (600 + 400 = capped at 1,000/day)\u001b[0m\r\n"]
[13.32, "o", "\r\n\u001b[1;36m==> 4) 30 days pass; a CRON tick arrives on Reactive -> rent is due\u001b[0m\r\n"]
[14.712, "o", "   [network] Cron100 delivered to react()\r\n"]
[14.741, "o", "   [network] callback posted: 0x062e96ad1b1e4b8fdc1e4464d6aa435943220eca5e9fc5bae00d1e3386d1f412\r\n"]
[14.787, "o", "\r\n\u001b[1;36m==>    landlord=900.00  totalPaid=900\u001b[0m\r\n"]
[16.207, "o", "\r\n\u001b[1;36m==> Final: wallet=7600.00 savings=1000.00 landlord=900.00  | incomeEvents=2 recurring=1\u001b[0m\r\n"]
